# MongoDB connection string
URL=mongodb://127.0.0.1:27017/visitor_pass_management

# Use a long random secret in real deployments
JWT_SECRET=replace_with_a_long_random_secret
PORT=4000
FRONTEND_URL=http://localhost:3000

# Initial admin account (used by npm run seed:admin)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_ORGANIZATION_NAME=Default Organization
ADMIN_ORGANIZATION_TYPE=other

# SMTP configuration. Email sending stays disabled until all values are set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=Visitor Pass System <noreply@example.com>

# OTP codes are printed to the server log when SMTP is not configured and NODE_ENV is not "production".
# Set to true to also do this in production (e.g. testing the Docker stack without SMTP). Never enable on a public server.
LOG_OTP_CODES=false
